{
  "name": "live2d-agent-companion",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests \"scripts/*.mjs\" package.json tsconfig.json vitest.config.ts",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && npm run start",
    "setup:live2d": "node scripts/setup-live2d.mjs",
    "setup:model": "python3 scripts/setup-model.py",
    "setup:electron": "install-electron",
    "configure:local": "node scripts/configure-local.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:x11": "node scripts/test-x11-input.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
